# Konnect token (kpat_… or spat_…) is read from a file, mounted as a compose secret.
# Default: ~/.kong/kpat. Override the path here if needed.
# It needs permission to create control planes, or to manage KONNECT_CP_NAME if it already exists.
# KONNECT_PAT_FILE=/path/to/kpat
# Konnect region of your org: us | eu | au | me | in | sg
KONNECT_REGION=us
# Hybrid control plane the flows are deployed to (created if missing).
KONNECT_CP_NAME=ipaas-local
# URL shown in the UI for flow endpoints (the local data plane proxy).
PUBLIC_GATEWAY_URL=http://localhost:8000

# Database connections are managed in the UI (Connections) and stored in the local Vault.
# Optionally seed some on first start: DB_CONN_<NAME>=postgres://user:pass@host:port/db
# (name = <name> lowercased; existing names are not overwritten). "sample" = the bundled stub DB.
# DB_CONN_SAMPLE=postgres://ipaas_app:app@sample-db:5432/sample
# DB_CONN_CRM=postgres://user:pass@host.docker.internal:5432/crm

# Host ports (change if they are taken on your machine).
# If you change GATEWAY_PORT, update PUBLIC_GATEWAY_URL to match.
# GATEWAY_PORT=8000
# GATEWAY_TLS_PORT=8443
# GATEWAY_STATUS_PORT=8100
# WEB_PORT=3000
# MOCKS_PORT=4010
# SAMPLE_DB_PORT=5433
# VAULT_PORT=8200
# AS2_PORT=4080
# SFTP_PORT=2222

# URL trading partners use to reach our AS2 endpoint (for async MDNs).
# AS2_PUBLIC_URL=http://localhost:4080/as2
